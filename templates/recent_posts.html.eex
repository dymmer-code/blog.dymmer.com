<div class="space-y-4">
  <%= for post <- @posts do %>
  <div class="border-b border-slate-100 dark:border-slate-800 pb-3 last:border-0 last:pb-0">
    <div class="text-xs font-mono text-slate-400 mb-1"><%= post[:date] %></div>
    <a href="/<%= @language %>/posts/<%= post[:id] %>" class="text-sm font-semibold text-slate-800 dark:text-slate-200 hover:text-brand-600 dark:hover:text-brand-400 transition-colors line-clamp-2">
      <%= post[:title] %>
    </a>
  </div>
  <% end %>
</div>
