  <!-- ========== HEADER ========== -->
  <header class="sticky top-0 z-40 bg-white/95 dark:bg-[#0c192b]/95 backdrop-blur-sm border-b border-slate-200 dark:border-slate-800 transition-colors">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="https://dymmer.com/" class="flex items-center gap-2">
        <img src="/assets/images/logo_light.png" class="h-7 block dark:hidden" alt="Dymmer">
        <img src="/assets/images/logo_dark.png" class="h-7 hidden dark:block" alt="Dymmer">
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
        <a href="https://dymmer.com/#bundles" class="hover:text-slate-900 dark:hover:text-white transition-colors"><%= gettext("Bundles") %></a>
        <a href="https://dymmer.com/#projects" class="hover:text-slate-900 dark:hover:text-white transition-colors"><%= gettext("Projects") %></a>
        <a href="https://dymmer.com/#how-it-works" class="hover:text-slate-900 dark:hover:text-white transition-colors"><%= gettext("How it works") %></a>
        <a href="/<%= @language %>/" class="text-brand-600 dark:text-brand-400 font-semibold hover:text-brand-700 transition-colors flex items-center gap-1.5">
          <span><%= gettext("Blog") %></span>
          <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
        </a>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Language Switcher ES / EN matching dymmer.com -->
        <div class="hidden sm:flex items-center gap-1 text-xs font-semibold text-slate-500">
          <a
            href="/es/<%= if assigns[:post], do: "posts/#{if(@language in [:es, "es"], do: @post[:id], else: @post[:alternate] || @post[:id])}", else: "" %>"
            class="<%= if @language in [:es, "es"], do: "px-1.5 py-0.5 rounded text-brand-500 font-bold", else: "px-1.5 py-0.5 rounded hover:text-slate-900 dark:hover:text-white transition-colors" %>"
          >
            ES
          </a>
          <span>/</span>
          <a
            href="/en/<%= if assigns[:post], do: "posts/#{if(@language in [:en, "en"], do: @post[:id], else: @post[:alternate] || @post[:id])}", else: "" %>"
            class="<%= if @language in [:en, "en"], do: "px-1.5 py-0.5 rounded text-brand-500 font-bold", else: "px-1.5 py-0.5 rounded hover:text-slate-900 dark:hover:text-white transition-colors" %>"
          >
            EN
          </a>
        </div>

        <!-- Theme toggle button -->
        <button
          type="button"
          onclick="toggleTheme()"
          aria-label="Toggle dark mode"
          class="p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a href="/<%= @language %>/" class="md:hidden text-sm font-semibold text-brand-600 dark:text-brand-400 mr-1"><%= gettext("Blog") %></a>
        <a href="https://dymmer.com/login" class="text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">
          <%= gettext("Log in") %>
        </a>
        <a href="https://dymmer.com/register" class="inline-flex items-center bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-4 py-2 rounded-md transition-colors shadow-sm">
          <%= gettext("Sign up") %>
        </a>
      </div>
    </div>
  </header>
