<%= render("head.html", assigns) %>
<body class="min-h-screen flex flex-col bg-white dark:bg-[#070f1a] text-slate-900 dark:text-slate-100 antialiased selection:bg-brand-100 selection:text-brand-900 transition-colors">

<%= render("header.html", assigns) %>

  <main class="flex-grow py-12 sm:py-16 max-w-4xl mx-auto px-6 w-full">
    <!-- Breadcrumb -->
    <div class="mb-8">
      <a href="/<%= @language %>/" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span><%= gettext("Back to all articles") %></span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
      <div class="flex flex-wrap items-center gap-2.5 text-xs text-slate-500 dark:text-slate-400 mb-4 font-medium">
        <%= if @post[:category] do %>
        <span class="px-2.5 py-0.5 rounded-full font-semibold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 border border-brand-200/80 dark:border-brand-800/80">
          <%= @post[:category] %>
        </span>
        <% end %>
        <span class="font-mono"><%= @post[:date] %></span>
        <%= if @post[:reading_time] do %>
        <span>&middot;</span>
        <span><%= @post[:reading_time] %> <%= gettext("min read") %></span>
        <% end %>
        <%= if @post[:author] do %>
        <span>&middot;</span>
        <span><%= if get_in(@post, [:_author, :name]), do: @post[:_author][:name], else: @post[:author] %></span>
        <% end %>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight mb-4">
        <%= @post[:title] %>
      </h1>

      <%= if @post[:subtitle] do %>
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed mb-6"><%= @post[:subtitle] %></p>
      <% end %>

      <%= if @post[:_tags] && @post[:_tags] != [] do %>
      <div class="flex flex-wrap gap-1.5">
        <%= for tag <- @post[:_tags] do %>
        <span class="px-2.5 py-0.5 rounded-md text-xs font-mono text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700">#<%= tag %></span>
        <% end %>
      </div>
      <% end %>
    </header>

    <!-- Article Body -->
    <article class="article-prose">
      <%= raw @post[:content] %>
    </article>

    <!-- Author Card -->
    <%= if @post[:_author] do %>
    <div class="clean-card p-6 sm:p-8 mt-14 flex flex-col sm:flex-row items-start sm:items-center gap-5">
      <div class="w-14 h-14 rounded-full bg-brand-100 dark:bg-brand-900/60 text-brand-600 dark:text-brand-300 font-bold text-xl flex items-center justify-center flex-shrink-0 border border-brand-200 dark:border-brand-800">
        <%= String.slice(get_in(@post, [:_author, :name]) || "D", 0, 1) %>
      </div>
      <div class="flex-grow">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-0.5"><%= gettext("Written by") %></div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-white"><%= @post[:_author][:name] %></h3>
        <%= if @post[:_author][:description] do %>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-1"><%= @post[:_author][:description] %></p>
        <% end %>
      </div>
      <%= if @post[:_author][:url] do %>
      <a href="<%= @post[:_author][:url] %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300">
        <span><%= gettext("Visit profile") %></span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
      <% end %>
    </div>
    <% end %>

    <!-- Back to bottom link -->
    <div class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center text-sm">
      <a href="/<%= @language %>/" class="inline-flex items-center gap-1.5 font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span><%= gettext("All articles") %></span>
      </a>
      <a href="#" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
        <%= gettext("Back to top") %> &uarr;
      </a>
    </div>
  </main>

<%= render("footer.html", assigns) %>

  <!-- Highlight.js & Mermaid Scripts -->
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/highlight.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/languages/erlang.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/languages/elixir.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/languages/bash.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/languages/javascript.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/languages/json.min.js"></script>
  <script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.10.0/build/languages/yaml.min.js"></script>

  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    // Keep the Markdown source: Mermaid replaces each container with an SVG.
    const diagrams = Array.from(document.querySelectorAll('pre > code.mermaid, pre > code.language-mermaid'), (codeEl) => {
      const container = document.createElement('div');
      const source = codeEl.textContent;
      container.className = 'mermaid my-6 flex justify-center';
      codeEl.parentElement.replaceWith(container);
      return { container, source };
    });

    const currentTheme = () => document.documentElement.classList.contains('dark') ? 'dark' : 'neutral';
    let renderedTheme;
    let rendering = false;

    async function renderDiagrams() {
      if (rendering || diagrams.length === 0) return;
      rendering = true;
      try {
        // Serialize renders, including theme changes made while Mermaid is busy.
        do {
          renderedTheme = currentTheme();
          mermaid.initialize({
            startOnLoad: false,
            theme: renderedTheme,
            fontFamily: 'Inter, system-ui, sans-serif'
          });
          diagrams.forEach(({ container, source }) => {
            container.removeAttribute('data-processed');
            container.textContent = source;
          });
          await mermaid.run({ nodes: diagrams.map(({ container }) => container) });
        } while (renderedTheme !== currentTheme());
      } catch (e) {
        console.error('Mermaid run error:', e);
      } finally {
        rendering = false;
      }
    }

    new MutationObserver(() => {
      if (renderedTheme !== currentTheme()) renderDiagrams();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });

    await renderDiagrams();

    hljs.highlightAll();
  </script>
</body>
</html>
