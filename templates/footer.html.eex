  <!-- ========== CTA BANNER ========== -->
  <section class="bg-gradient-to-r from-brand-600 to-brand-800 text-white">
    <div class="max-w-4xl mx-auto px-6 py-14 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white text-balance">
        <%= gettext("Ready to get started?") %>
      </h2>
      <p class="mt-3 text-brand-100 max-w-xl mx-auto text-sm sm:text-base">
        <%= gettext("Register your domain and get everything you need to launch, with real human support when you need it.") %>
      </p>
      <a href="https://dymmer.com/register" class="mt-6 inline-flex items-center gap-2 bg-white text-brand-800 hover:bg-brand-50 font-semibold px-6 py-3 rounded-lg transition-colors shadow-sm">
        <%= gettext("Create your account") %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0c192b] py-10 transition-colors">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <img src="/assets/images/logo_light.png" class="h-6 block dark:hidden" alt="Dymmer">
        <img src="/assets/images/logo_dark.png" class="h-6 hidden dark:block" alt="Dymmer">
        <span class="text-xs text-slate-400 dark:text-slate-500">&copy; <%= @current_year %> Dymmer. <%= gettext("All rights reserved.") %></span>
      </div>
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="https://dymmer.com/about" class="underline underline-offset-4 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"><%= gettext("About") %></a>
        <a href="https://dymmer.com/help" class="underline underline-offset-4 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"><%= gettext("Help & Glossary") %></a>
        <a href="https://dymmer.com/terms-of-service" class="underline underline-offset-4 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"><%= gettext("Terms of Service") %></a>
        <a href="https://dymmer.com/legal/privacy" class="underline underline-offset-4 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"><%= gettext("Privacy Policy") %></a>
        <a href="https://dymmer.com/legal/cookies" class="underline underline-offset-4 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"><%= gettext("Cookie Policy") %></a>
        <a href="https://dymmer.com/legal/withdraw" class="underline underline-offset-4 hover:text-brand-500 dark:hover:text-brand-400 transition-colors"><%= gettext("Withdraw from contract") %></a>
        <a href="/<%= @language %>/" class="underline underline-offset-4 hover:text-brand-500 font-semibold text-brand-600 dark:text-brand-400 transition-colors"><%= gettext("Blog") %></a>
      </nav>
    </div>
  </footer>
